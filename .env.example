# WUB BloodConnect Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=wub_bloodconnect_super_secret_jwt_key_2026_student_network
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL in production, automatically uses SQLite fallback locally if not running)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wub_bloodconnect
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=wub_bloodconnect
PGPORT=5432

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Security
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
